# =============================================================================
# Coti Auto · monorepo (Next.js + FastAPI builder + Drive en el mismo contenedor)
# =============================================================================

# --- Anthropic (Claude) ----------------------------------------------------
# Clave de la API de Anthropic — obligatoria para generar la cotización.
ANTHROPIC_API_KEY=

# Modelo y tope de tokens. Defaults conservadores.
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=16000

# --- Auth (NextAuth + Google OAuth) ----------------------------------------
# Cada usuario inicia sesión con su Google para leer Docs sin compartirlos.
# Crea credenciales OAuth (Web) en Google Cloud Console y agrega como
# Authorized redirect URI:
#   https://<tu-dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Llave de firma para las cookies JWT. Genera una nueva:
#   openssl rand -base64 32
AUTH_SECRET=

# URL pública del dashboard (solo en producción si el dominio no se autodetecta)
# AUTH_URL=https://dashboard-zebra-cotis.9qd6cz.easypanel.host

# --- Google Drive (cuenta de servicio) -------------------------------------
# Pega el JSON COMPLETO de la cuenta de servicio. Una sola línea (escapes
# para los saltos de línea de la private_key). Ej:
#   GOOGLE_SA_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",...}
GOOGLE_SA_JSON=

# Carpetas de Drive. Ambas deben estar compartidas con el email de la cuenta
# de servicio en modo "Editor".
#
# DRIVE_FOLDER_ID_COTIZACIONES → DOCX (Google Doc) + XLSX (Google Sheet)
# DRIVE_FOLDER_ID_EVALUACIONES → PDF del diagnóstico (WeasyPrint)
DRIVE_FOLDER_ID_COTIZACIONES=1d7Uj4dMx4USMNum-lkD_2w33OAeQgkCD
DRIVE_FOLDER_ID_EVALUACIONES=

# Legacy: si solo seteas DRIVE_FOLDER_ID, todo va a la misma carpeta. Las
# variables específicas tienen prioridad sobre esta.
# DRIVE_FOLDER_ID=1d7Uj4dMx4USMNum-lkD_2w33OAeQgkCD

# --- Builder Python (mismo contenedor) -------------------------------------
# Por default vive en localhost; solo cambia si separas servicios.
ZEBRA_API_URL=http://127.0.0.1:8080
ZEBRA_API_TIMEOUT_MS=60000

# Opcional: si lo seteas, el builder exige X-API-Key y el dashboard lo manda.
ZEBRA_API_KEY=

# --- UI --------------------------------------------------------------------
# URLs públicas de Drive para los dos botones del header. Si solo defines
# NEXT_PUBLIC_DRIVE_FOLDER_URL (legacy), los dos botones apuntan a la misma
# carpeta.
NEXT_PUBLIC_DRIVE_FOLDER_URL_COTIZACIONES=https://drive.google.com/drive/folders/1d7Uj4dMx4USMNum-lkD_2w33OAeQgkCD
NEXT_PUBLIC_DRIVE_FOLDER_URL_EVALUACIONES=
# NEXT_PUBLIC_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1d7Uj4dMx4USMNum-lkD_2w33OAeQgkCD

# Tag visible en el footer. EasyPanel lo puede pasar como build arg.
BUILD_TAG=local
NEXT_PUBLIC_BUILD_TAG=local
