# --- Modo n8n (legacy, sigue siendo el default del dashboard) ---
# URL del webhook de n8n que genera la cotización (DOCX + opcional XLSX) y lo
# sube a Drive. Sigue siendo el camino que usa el formulario por ahora.
N8N_WEBHOOK_URL=https://n8n-n8n.9qd6cz.easypanel.host/webhook/85a05e12-43a0-449e-9c8a-3e1df24b4769

# Tiempo máximo (ms) que el servidor espera la respuesta del webhook
WEBHOOK_TIMEOUT_MS=300000

# --- Modo directo (Fase 2 de migración) ---
# El endpoint /api/quote-direct usa estas variables. Aún no está cableado al
# formulario; se prueba con curl/Postman hasta que validemos paridad.

# API key de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Modelo y tope de tokens. Defaults conservadores para Opus 4.7.
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_MAX_TOKENS=16000

# URL interna del microservicio que genera DOCX/XLSX. En EasyPanel, si vive en
# el mismo proyecto, suele ser `http://zebra-api:8080` (mismo que usa n8n).
ZEBRA_API_URL=http://zebra-api:8080
ZEBRA_API_TIMEOUT_MS=60000

# --- UI ---
# Carpeta de Drive que se muestra desde el botón del header.
NEXT_PUBLIC_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1d7Uj4dMx4USMNum-lkD_2w33OAeQgkCD

# Tag visible en el footer; útil para confirmar deploys.
BUILD_TAG=local
NEXT_PUBLIC_BUILD_TAG=local
